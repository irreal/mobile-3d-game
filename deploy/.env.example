# Copy to .env and fill in.

# Hostname for the signalling endpoint. Its DNS record must point at the VPS and be
# "DNS only" (grey cloud) in Cloudflare: game traffic is UDP straight to this IP.
DOMAIN=novastrike.irreal.dev
# The VPS's public IPv4; advertised to browsers as the WebRTC address.
PUBLIC_IP=203.0.113.10
# Let's Encrypt account email.
EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on the domain's zone (for the DNS challenge).
CLOUDFLARE_API_TOKEN=

# HTTPS signalling port (TCP) and WebRTC port (UDP). Open both in the firewall.
SIGNAL_PORT=7443
RTC_UDP_PORT=47100

# Comma-separated origins allowed to connect (where the game is served from).
ALLOWED_ORIGINS=https://irreal.github.io,http://localhost:5173
MAX_PLAYERS=16

# 1 = use the Let's Encrypt staging CA while testing (untrusted certs, generous rate limits).
CERTBOT_STAGING=0
